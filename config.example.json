{
  "start": "normal",
  "modes": {
    "normal": {
      "keys": {
        "/": { "label": "Find file", "run": "vim.open:herdr-fff" },
        "x": null,
        "d": { "label": "Close pane", "run": "pane.close" },
        "space": {
          "label": "Leader",
          "keys": {
            "f": {
              "label": "Find",
              "keys": {
                "f": { "label": "Files", "run": "vim.open:herdr-fff" },
                "g": {
                  "label": "Changed files",
                  "run": { "command": "vim.open", "args": { "mod": "herdr-fff", "props": { "changed": true } } }
                }
              }
            },
            "e": { "label": "nvim sidebar", "run": "mod.open:herdr-nvim", "then": "insert" }
          }
        },
        "w": { "label": "Window mode", "run": "vim.mode:window" }
      }
    },
    "window": {
      "label": "WINDOW",
      "replace": true,
      "keys": {
        "h": "pane.go:left",
        "l": "pane.go:right",
        "z": { "label": "Zoom", "run": "pane.zoom" },
        "escape": { "label": "Normal mode", "run": "vim.mode:normal" }
      }
    }
  }
}

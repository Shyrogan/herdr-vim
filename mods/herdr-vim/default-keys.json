{
  "normal": {
    "h": "herdr-vim.go:left",
    "j": "herdr-vim.go:down",
    "k": "herdr-vim.go:up",
    "l": "herdr-vim.go:right",
    "shift-h": "pane.swap:left",
    "shift-j": "pane.swap:down",
    "shift-k": "pane.swap:up",
    "shift-l": "pane.swap:right",
    "v": "pane.split:right",
    "s": "pane.split:down",
    "x": "pane.close",
    "f": "pane.zoom",
    "t": "tab.new",
    "shift-t": "space.new",
    "n": "agent.next",
    "shift-n": "agent.prev",
    "g": "herdr-vim.once:go",
    "m": "herdr-vim.mode:move",
    "1": "space.select:1",
    "2": "space.select:2",
    "3": "space.select:3",
    "4": "space.select:4",
    "5": "space.select:5",
    "6": "space.select:6",
    "7": "space.select:7",
    "8": "space.select:8",
    "9": "space.select:9",
    "&": "space.select:1",
    "é": "space.select:2",
    "\"": "space.select:3",
    "'": "space.select:4",
    "(": "space.select:5",
    "-": "space.select:6",
    "è": "space.select:7",
    "_": "space.select:8",
    "ç": "space.select:9",
    "r": "herdr-vim.insert:tab.rename",
    "shift-r": "herdr-vim.insert:space.rename",
    ":": "herdr-vim.insert:app.palette",
    "?": "herdr-vim.help",
    "i": "herdr-vim.insert"
  },
  "go": {
    "t": "tab.next",
    "shift-t": "tab.prev",
    "s": "space.next",
    "shift-s": "space.prev"
  },
  "move": {
    "h": "pane.swap:left",
    "j": "pane.swap:down",
    "k": "pane.swap:up",
    "l": "pane.swap:right",
    "?": "herdr-vim.help",
    "i": "herdr-vim.insert",
    "escape": "herdr-vim.mode:normal"
  }
}
